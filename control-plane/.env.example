DATABASE_HOST=aws.connect.psdb.cloud
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password
DATABASE_NAME=agent-world

PORT=4000

# Fly.io API token (for deploying to Fly)
FLY_API_TOKEN=your_fly_api_token

# Sprites.dev token (for agent sprites)
SPRITES_TOKEN=your_sprites_token

ANTHROPIC_API_KEY=your_anthropic_api_key

# Local development only: single sprite URL for all agents
# In production, each agent uses their own spriteUrl from the database
SPRITE_BASE_URL=http://localhost:4001

# For production (Fly.io), these are set via fly secrets:
# fly secrets set DATABASE_HOST=... DATABASE_USERNAME=... ANTHROPIC_API_KEY=... etc.
